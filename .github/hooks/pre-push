#!/usr/bin/env bash
# Pre-push hook: blocks `git push` from this repo if .github/agents/,
# .github/skills/, or .github/prompts/ have drifted from the marketplace.
#
# Bypass with `git push --no-verify` if you absolutely must (e.g. you've
# already pushed to the marketplace via a different machine).
#
# Installed by: pwsh .github/scripts/install-hooks.ps1

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
SYNC_SCRIPT="$REPO_ROOT/.github/scripts/sync-agents.ps1"

if [ ! -f "$SYNC_SCRIPT" ]; then
    exit 0
fi

# Read stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
# Determine if any pushed commits touch agents/skills/prompts.
zero="0000000000000000000000000000000000000000"
should_check=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    if git diff --name-only "$range" 2>/dev/null | grep -Eq '^\.github/(agents|skills|prompts)/'; then
        should_check=1
        break
    fi
done

if [ "$should_check" -eq 0 ]; then
    exit 0
fi

echo "[pre-push] Checking marketplace sync (agents/skills/prompts changed)..."

# Find pwsh - try common names
PWSH_CMD=""
for cmd in pwsh pwsh.exe powershell powershell.exe; do
    if command -v "$cmd" >/dev/null 2>&1; then
        PWSH_CMD="$cmd"
        break
    fi
done

if [ -z "$PWSH_CMD" ]; then
    echo "[pre-push] WARNING: pwsh not found, skipping marketplace check." >&2
    exit 0
fi

"$PWSH_CMD" -NoProfile -File "$SYNC_SCRIPT" -Check
code=$?

if [ "$code" -ne 0 ]; then
    echo ""
    echo "[pre-push] BLOCKED: marketplace is out of sync." >&2
    echo "[pre-push] Run the push first:" >&2
    echo "  pwsh .github/scripts/sync-agents.ps1 -Push -Message '<msg>'" >&2
    echo "[pre-push] Or bypass (use sparingly): git push --no-verify" >&2
    exit 1
fi

exit 0
