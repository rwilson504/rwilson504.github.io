---
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getLinkableTags } from "../utils/tags";
import { categoryLabel } from "../utils/categories";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  heroImage?: string;
  heroImageAlt?: string;
}

const { title, description, pubDate, updatedDate, category, tags, heroImage } = Astro.props;
const linkable = await getLinkableTags();
---

<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate?.toISOString(),
    tags,
  }}
>
  <article data-pagefind-body>
    <header style="margin-bottom: 2em;">
      <a class="category-pill" href={`/categories/${category}/`}>{categoryLabel(category)}</a>
      <h1 style="margin: 0.25em 0;">{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <>
            {" · updated "}
            <FormattedDate date={updatedDate} />
          </>
        )}
      </p>
      {tags.length > 0 && (
        <p style="margin-top: 0.5em;">
          {tags.map((t) =>
            linkable.has(t)
              ? <a class="tag" href={`/tags/${t}/`}>{t}</a>
              : <span class="tag">{t}</span>
          )}
        </p>
      )}
      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          loading="eager"
          decoding="async"
          class="post-hero"
        />
      )}
    </header>
    <div class="post-content" data-zoomable-images>
      <slot />
    </div>
  </article>
  <dialog class="image-zoom-dialog" aria-label="Image preview">
    <button class="image-zoom-close" type="button" aria-label="Close image preview">x</button>
    <img class="image-zoom-img" alt="" />
  </dialog>
  <script is:inline>
    (() => {
      const content = document.querySelector("[data-zoomable-images]");
      const dialog = document.querySelector(".image-zoom-dialog");
      const zoomedImage = document.querySelector(".image-zoom-img");
      const closeButton = document.querySelector(".image-zoom-close");

      if (!content || !dialog || !zoomedImage || !closeButton) return;

      const getZoomImage = (target) => {
        if (target instanceof HTMLImageElement && target.closest("[data-zoomable-images]")) {
          return target;
        }

        if (target instanceof Element) {
          const link = target.closest("a.zoomable-image-link");
          const image = link?.querySelector("img.zoomable-image");
          return image instanceof HTMLImageElement ? image : null;
        }

        return null;
      };

      const openImage = (image) => {
        zoomedImage.src = image.currentSrc || image.src;
        zoomedImage.alt = image.alt || "Expanded article image";
        dialog.showModal();
        closeButton.focus();
      };

      content.querySelectorAll("img").forEach((image) => {
        image.classList.add("zoomable-image");
        const link = image.closest("a");
        const label = image.alt ? `Zoom image: ${image.alt}` : "Zoom article image";

        if (link) {
          link.classList.add("zoomable-image-link");
          link.setAttribute("aria-label", label);
          return;
        }

        image.setAttribute("tabindex", "0");
        image.setAttribute("role", "button");
        image.setAttribute("aria-label", label);
      });

      content.addEventListener("click", (event) => {
        const image = getZoomImage(event.target);
        if (!image) return;
        event.preventDefault();
        openImage(image);
      });

      content.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        const image = getZoomImage(event.target);
        if (!image) return;
        event.preventDefault();
        openImage(image);
      });

      closeButton.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        zoomedImage.removeAttribute("src");
      });
    })();
  </script>
</BaseLayout>
